# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (SUPABASE + CLOUD TEMPLATE)
# ==============================================================================
# Lưu ý: File này chỉ là mẫu hướng dẫn (Template) được commit lên Git.
# Tuyệt đối KHÔNG điền key thật vào file này.
# Khi deploy lên Render / Railway, hãy copy và điền các giá trị thật vào mục
# Environment Variables trong Web Dashboard của dịch vụ hosting.

# 1. Database (Supabase PostgreSQL)
# Lấy từ: Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC
DB_URL=jdbc:postgresql://[YOUR-SUPABASE-HOST]:5432/postgres?sslmode=require
DB_USERNAME=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=[YOUR-SUPABASE-DATABASE-PASSWORD]

# 2. Spring Profile
SPRING_PROFILES_ACTIVE=prod

# 3. Security (JWT Secret Key - 256-bit Hex / Base64)
# Gợi ý: Tạo chuỗi ngẫu nhiên 64 ký tự hex an toàn cho production
JWT_SECRET_KEY=[YOUR-STRONG-256-BIT-JWT-SECRET-KEY]

# 4. MoMo Payment Gateway (Lấy từ MoMo Developer Portal)
MOMO_PARTNER_CODE=[YOUR-MOMO-PARTNER-CODE]
MOMO_ACCESS_KEY=[YOUR-MOMO-ACCESS-KEY]
MOMO_SECRET_KEY=[YOUR-MOMO-SECRET-KEY]
MOMO_REDIRECT_URL=https://[YOUR-PRODUCTION-DOMAIN]/api/payments/momo/return
MOMO_IPN_URL=https://[YOUR-PRODUCTION-DOMAIN]/api/payments/momo/ipn

# ==============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Hướng dẫn: Copy file này thành .env trên máy của bạn và điền mật khẩu thật.
# File .env sẽ được gitignore tự động bỏ qua, không bị đẩy lên GitHub.

# Database Local (Docker PostgreSQL port 5433)
DB_PASSWORD=your_local_db_password

# Security (JWT Secret Key 256-bit Hex)
JWT_SECRET_KEY=9D3A4B5C6D7E8F9A0B1C2D3E4F5A6B7C8D9E0F1A2B3C4D5E6F7A8B9C0D1E2F3A


# VNPay Sandbox (backend only). Enable only on an approved isolated test environment.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_IPN_URL=
VNPAY_RETURN_URL=
VNPAY_FRONTEND_ORIGIN=http://localhost:5173
